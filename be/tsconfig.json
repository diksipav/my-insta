{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,

    // Node runs the .ts files directly (type stripping), so imports use .ts
    // extensions and only erasable TS syntax is allowed (no enums/namespaces).
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "outDir": "dist",
    "sourceMap": true
  },
  // Type-checks app code and scripts. Builds use tsconfig.build.json (src only).
  "include": ["src", "scripts"]
}
